# Modelo das variáveis do Lastro. Copie para .env.local (versão local) ou cadastre na Vercel
# (versão na nuvem). Nunca ponha valores reais neste arquivo: ele vai para o Git.

# --- Leitura por IA (as duas versões) ---------------------------------------
GEMINI_API_KEY=
# GEMINI_MODELO=

# --- NF Status (SERPRO), opcional -------------------------------------------
# SERPRO_CONSUMER_KEY=
# SERPRO_SECRET_KEY=

# --- Versão local -----------------------------------------------------------
# Pasta do banco e dos arquivos (padrão: ./data)
# BATE_PDF_DADOS=

# --- Versão na nuvem (Vercel) -----------------------------------------------
# Banco: Turso. Sem estas duas, o app usa o arquivo local.
# TURSO_DATABASE_URL=libsql://<banco>-<conta>.turso.io
# TURSO_AUTH_TOKEN=

# Arquivos: Vercel Blob (store PRIVADO). A Vercel cria esta sozinha ao ligar o Blob ao projeto.
# BLOB_READ_WRITE_TOKEN=

# Login: Google da empresa (Auth.js). Sem AUTH_GOOGLE_ID, não há login (versão local).
# AUTH_SECRET=            # gere com: npx auth secret
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# LASTRO_DOMINIO=denvercontabil.com.br
