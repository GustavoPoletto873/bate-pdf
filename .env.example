# Modelo das variáveis do Lastro. Copie para .env.local (versão local) ou cadastre na Vercel
# (versão na nuvem). Nunca ponha valores reais neste arquivo: ele vai para o Git.

# --- Leitura por IA (as duas versões) ---------------------------------------
GEMINI_API_KEY=
# GEMINI_MODELO=

# --- NF Status (SERPRO), opcional -------------------------------------------
# SERPRO_CONSUMER_KEY=
# SERPRO_SECRET_KEY=

# --- Versão local -----------------------------------------------------------
# Pasta do banco e dos arquivos (padrão: ./data)
# BATE_PDF_DADOS=

# --- Versão na nuvem (Vercel) -----------------------------------------------
# Banco: Turso. Sem estas duas, o app usa o arquivo local.
# TURSO_DATABASE_URL=libsql://<banco>-<conta>.turso.io
# TURSO_AUTH_TOKEN=

# Arquivos: Vercel Blob (store PRIVADO). A Vercel cria esta sozinha ao ligar o Blob ao projeto.
# BLOB_READ_WRITE_TOKEN=

# --- Login: conta própria, e-mail + senha + authenticator (como no Bate Lastro) ---
# Cifra o cookie de sessão e os segredos do authenticator (32+ caracteres). Na Vercel é obrigatório;
# no computador, sem ele o login fica desligado (abre direto). Não troque depois de criar as contas.
# SESSAO_SEGREDO=
# Cria o primeiro administrador na tela de entrar, enquanto não existe nenhuma conta (16+ caracteres).
# CHAVE_INSTALACAO=
# Quem pode ter conta (padrão: só o domínio da Denver).
# ACESSO_DOMINIOS=denvercontabil.com.br
# ACESSO_EMAILS=
